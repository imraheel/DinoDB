{
  "name": "nexdb",
  "version": "0.1.7-alpha",
  "private": true,
  "description": "NexDB — a fast MongoDB client",
  "license": "GPL-3.0-only",
  "author": "NexDB <dev@nexdb.app>",
  "main": "out/main/index.js",
  "scripts": {
    "build:utility": "tsc -p tsconfig.utility.json && node -e \"const {rmSync,globSync}=require('node:fs');for(const f of globSync('out/**/*.test.js'))rmSync(f)\"",
    "dev": "pnpm run build:utility && electron-vite dev",
    "build": "pnpm run build:utility && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.utility.json --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/run-tests.mjs",
    "clean": "rm -rf dist out",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "package:all": "pnpm build && electron-builder --mac --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
